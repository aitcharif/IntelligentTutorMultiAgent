# ===== LLM Configuration =====

# Use local LLM by default (no API key needed)
USE_LOCAL_LLM=true

# Local LLM (Ollama)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=mistral
# Alternative models: aya (better for Arabic), codellama, llama2

# Cloud LLM (Optional - only if USE_LOCAL_LLM=false)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLOUD_LLM_PROVIDER=openai
CLOUD_LLM_MODEL=gpt-4

# ===== RAG Configuration =====

# Vector Database
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION=moroccan_cs_knowledge

# Embeddings Model (supports French and Arabic)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# Alternative: intfloat/multilingual-e5-large

# RAG Settings
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7

# ===== Audio Configuration =====

# Speech-to-Text
STT_SERVICE=whisper
# Options: whisper, google, azure
WHISPER_MODEL=base
# Options: tiny, base, small, medium, large

# Text-to-Speech
TTS_SERVICE=gtts
# Options: gtts, elevenlabs, azure
TTS_LANGUAGE=fr
# Options: fr, ar

# Audio Settings
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_DURATION=5

# ===== API Configuration =====

API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=4

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]
CORS_ALLOW_CREDENTIALS=true

# ===== Language Settings =====

DEFAULT_LANGUAGE=fr
# Options: fr (Français), ar (العربية), en (English)

SUPPORTED_LANGUAGES=["fr","ar","en"]

# ===== Session Configuration =====

SESSION_TIMEOUT=3600
MAX_HISTORY_MESSAGES=50

# ===== Logging =====

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR
LOG_FILE=logs/app.log

# ===== Database =====

DATABASE_URL=sqlite:///./data/app.db
# For production: postgresql://user:password@localhost/dbname

# ===== Agent Configuration =====

# Coordinator
COORDINATOR_TEMPERATURE=0.7
COORDINATOR_MAX_TOKENS=2000

# Tutor Agent
TUTOR_TEMPERATURE=0.8
TUTOR_MAX_TOKENS=3000

# Evaluator Agent
EVALUATOR_TEMPERATURE=0.3
EVALUATOR_MAX_TOKENS=2000

# Generator Agent
GENERATOR_TEMPERATURE=0.9
GENERATOR_MAX_TOKENS=4000

# ===== Moroccan Context =====

# Curriculum Level
CURRICULUM_LEVEL=all
# Options: tronc_commun, premiere_bac, deuxieme_bac, all

# Educational System
EDUCATION_SYSTEM=moroccan
# Options: moroccan, french, international

# ===== Development =====

DEBUG=true
ENVIRONMENT=development
# Options: development, staging, production
